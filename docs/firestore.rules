// ==========================================================================
// FIRESTORE SECURITY RULES — v4 (adds uploaded files, leave requests, change history)
// ==========================================================================
// Paste this into: Firebase Console → Firestore Database → Rules → Publish
//
// Everything here works on the free Spark plan (no Cloud Functions, no
// custom claims). Role is determined by:
//   - /admins/{uid}                exists  -> caller is the lecturer (admin)
//   - /students/{rollNo}.authUid  == uid   -> caller is that student
// ==========================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwningStudent(rollNumber) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/students/$(rollNumber)).data.authUid == request.auth.uid;
    }

    // ---- Admin accounts: created by hand in the Firebase Console.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- Students: admin has full access. A student can read their own
    // record, and may change ONLY their own `loginPassword` field (used by
    // the "Change My Password" page so your copy stays in sync).
    match /students/{rollNumber} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.authUid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.authUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loginPassword']) &&
        request.resource.data.loginPassword is string &&
        request.resource.data.loginPassword.size() >= 6
      );
    }

    // ---- Roll number -> hidden login email. The login page must look this
    // up BEFORE signing in, so a single lookup by roll number is public —
    // but listing the whole collection (all roll numbers) is admin-only.
    match /studentLogins/{rollNumber} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ---- Courses, course plans, settings, grade item definitions,
    // announcements, course files, ebooks: everyone signed in can read
    // (students need them), only the admin can change them.
    match /courses/{id}        { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /coursePlans/{id}    { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /settings/{id}       { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /gradeItems/{id}     { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /announcements/{id}  { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /courseContent/{id}  { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /ebooks/{id}         { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // ---- Attendance (v2): one doc per student per course
    // ({COURSE}__{ROLL}, field `days` = { 'YYYY-MM-DD': status }).
    // A student can read only their own.
    match /attendanceSummary/{id} {
      allow read: if isAdmin() || (isSignedIn() && isOwningStudent(resource.data.rollNumber));
      allow write: if isAdmin();
    }

    // ---- Old (v1) attendance — kept only so the one-time upgrade can read it.
    match /attendance/{id} {
      allow read, write: if isAdmin();
    }

    // ---- Marks and bonus/negative adjustments: a student reads only their own.
    match /gradeMarks/{id} {
      allow read: if isAdmin() || (isSignedIn() && isOwningStudent(resource.data.rollNumber));
      allow write: if isAdmin();
    }
    match /gradebookAdjustments/{id} {
      allow read: if isAdmin() || (isSignedIn() && isOwningStudent(resource.data.rollNumber));
      allow write: if isAdmin();
    }

    // ---- Online quizzes (v3) -------------------------------------------
    // The answer key: lecturer only. Students can never read it.
    match /quizKeys/{itemId} {
      allow read, write: if isAdmin();
    }

    // The question paper (no answers until results are published).
    // Students can read it only while the quiz is open or closed — never
    // while it is still a draft, so questions stay hidden before the quiz.
    match /quizPapers/{itemId} {
      allow read: if isAdmin() || (isSignedIn() &&
        get(/databases/$(database)/documents/gradeItems/$(itemId)).data.online.status in ['open', 'closed']);
      allow write: if isAdmin();
    }

    // One attempt per student per quiz: {itemId}__{rollNumber}.
    match /quizAttempts/{attemptId} {
      function quiz(itemId) {
        return get(/databases/$(database)/documents/gradeItems/$(itemId)).data.online;
      }

      allow read: if isAdmin() || (isSignedIn() && isOwningStudent(resource.data.rollNumber));

      // A student starts their own attempt, only while the quiz is open and
      // inside its opening window. startedAt must be the server's clock.
      allow create: if isSignedIn()
        && attemptId == request.resource.data.itemId + '__' + request.resource.data.rollNumber
        && isOwningStudent(request.resource.data.rollNumber)
        && request.resource.data.keys().hasOnly(['itemId', 'rollNumber', 'courseCode', 'status', 'startedAt', 'answers', 'tabSwitches'])
        && request.resource.data.status == 'started'
        && request.resource.data.startedAt == request.time
        && quiz(request.resource.data.itemId).status == 'open'
        && (quiz(request.resource.data.itemId).get('opensAtTs', null) == null
            || request.time >= quiz(request.resource.data.itemId).opensAtTs)
        && (quiz(request.resource.data.itemId).get('closesAtTs', null) == null
            || request.time < quiz(request.resource.data.itemId).closesAtTs);

      // The student may save answers and submit — only until their own time
      // limit (+2 minutes grace) runs out, and never after submitting.
      allow update: if isAdmin() || (isSignedIn()
        && isOwningStudent(resource.data.rollNumber)
        && resource.data.status == 'started'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'status', 'submittedAt', 'tabSwitches'])
        && request.resource.data.status in ['started', 'submitted']
        && (request.resource.data.status == 'started' || request.resource.data.submittedAt == request.time)
        && request.time < resource.data.startedAt + duration.value(int(quiz(resource.data.itemId).durationMin) * 60 + 120, 's'));

      allow delete: if isAdmin();
    }

    // ---- Live class check-in (v3) -------------------------------------
    // The code itself: lecturer only (students can never read it).
    match /checkins/{id} {
      allow read, write: if isAdmin();
    }
    // A student's check-in is accepted only if the code matches today's
    // code for that course and it has not expired. One check-in per class.
    match /checkinResponses/{id} {
      function checkin() {
        return get(/databases/$(database)/documents/checkins/$(request.resource.data.courseCode + '__' + request.resource.data.date)).data;
      }
      allow read: if isAdmin() || (isSignedIn() && isOwningStudent(resource.data.rollNumber));
      allow create: if isSignedIn()
        && id == request.resource.data.courseCode + '__' + request.resource.data.date + '__' + request.resource.data.rollNumber
        && isOwningStudent(request.resource.data.rollNumber)
        && request.resource.data.keys().hasOnly(['courseCode', 'date', 'rollNumber', 'code', 'at'])
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/checkins/$(request.resource.data.courseCode + '__' + request.resource.data.date))
        && checkin().code == request.resource.data.code
        && request.time < checkin().expiresAt;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- Online assignment submissions (v3) ---------------------------
    // A student submits (or replaces) a link for an assignment that allows
    // online submission. The time is the server's, so "late" is honest.
    match /submissions/{id} {
      allow read: if isAdmin() || (isSignedIn() && isOwningStudent(resource.data.rollNumber));
      allow create, update: if isSignedIn()
        && id == request.resource.data.itemId + '__' + request.resource.data.rollNumber
        && isOwningStudent(request.resource.data.rollNumber)
        && request.resource.data.keys().hasOnly(['itemId', 'rollNumber', 'courseCode', 'url', 'note', 'submittedAt'])
        && request.resource.data.url is string && request.resource.data.url.size() < 1000
        && request.resource.data.url.matches('https://.+')
        && request.resource.data.note is string && request.resource.data.note.size() < 1000
        && request.resource.data.submittedAt == request.time
        && get(/databases/$(database)/documents/gradeItems/$(request.resource.data.itemId)).data.get('allowSubmission', false) == true;
      allow delete: if isAdmin();
    }

    // ---- Uploaded files (v4): PDFs are stored in 900 KB pieces.
    // Everyone signed in can read (students open course PDFs); only the
    // lecturer can upload or delete. Each piece must stay below 1 MB.
    match /fileChunks/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 921600;
      allow delete: if isAdmin();
    }

    // ---- Change history (v4): only the lecturer can see or add entries.
    // Entries can never be edited, so the history stays honest.
    match /auditLog/{id} {
      allow read, create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- Leave requests (v4): a student asks for leave; the lecturer
    // approves or rejects. Students see only their own, and can withdraw
    // a request while it is still pending.
    match /leaveRequests/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.authUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['rollNumber', 'studentName', 'authUid', 'courseCode', 'from', 'to', 'reason', 'status', 'createdAt'])
        && request.resource.data.authUid == request.auth.uid
        && isOwningStudent(request.resource.data.rollNumber)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.from is string && request.resource.data.from.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.to is string && request.resource.data.to.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.to >= request.resource.data.from
        && request.resource.data.courseCode is string && request.resource.data.courseCode.size() < 40
        && request.resource.data.studentName is string && request.resource.data.studentName.size() < 120
        && request.resource.data.reason is string && request.resource.data.reason.size() > 2 && request.resource.data.reason.size() <= 600;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authUid == request.auth.uid && resource.data.status == 'pending');
    }

    // ---- Anything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
